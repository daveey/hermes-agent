#!/usr/bin/env python3
"""Run every blocking lint check CI runs, locally, with the same pinned tools: the lint
the workflow's guards, ruff and the code-health ratchet, plus the case-collision, lazy-deps,
profile-archive, prompt-surface and blob-size guards that CI runs in workflows of their own.

    python scripts/check                # everything, against the merge-base with origin/main
    python scripts/check --only health  # just the code-health ratchet
    python scripts/check --staged       # judge the index (the pre-commit hook runs this)
    python scripts/check --commit REV   # judge one commit (the pre-push hook runs this)
    python scripts/check --install-hook [pre-commit|pre-push]   # run it automatically
    python scripts/check --uninstall-hook

CI runs the same command (``.github/workflows/lint.yml``), so a green local run means a green
lint lane. On macOS core execution is refused: portable core checks belong on a pool worker.
Hook management remains available. Shared hooks admit only structurally identified state
candidates on Macs, running their own checker; core, mixed and unknown trees fail closed.
Refresh installed hooks after updating: their admission also protects historical candidates.
Hooks are skippable (``--no-verify``); CI is not. The code-health part honours the
``ENFORCEMENT`` switch in ``scripts/code_health/config.py`` (blocking / advisory / off).
"""

from __future__ import annotations

import argparse
import ast
import os
import subprocess
import sys
import tempfile
from collections.abc import Iterator
from concurrent.futures import ThreadPoolExecutor
from contextlib import contextmanager
from dataclasses import dataclass
from pathlib import Path

# Before the engine imports: they need 3.11 (tomllib), and an older python3 first on PATH would
# otherwise die in a traceback on every hooked commit or push.
if sys.version_info < (3, 11):
    print(f"scripts/check needs Python 3.11+, this is {'.'.join(map(str, sys.version_info[:3]))};"
          " run it with the repo's virtualenv (.venv/bin/python scripts/check)", file=sys.stderr)
    raise SystemExit(2)

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO))

from scripts.code_health import gitio  # noqa: E402
from scripts.code_health.ruff_runner import resolve_ruff  # noqa: E402

_HOOK_MARK = "# hermes-agent scripts/check hook"
# Hooks are shared by every worktree of the clone, so the checked-out branch decides nothing:
# each candidate (the index being committed, the tip of each pushed branch) is materialized and
# judged by its own scripts/check. Non-Mac candidates predating scripts/check are not judged;
# Macs admit only the known state layout, even when the candidate has no checker.
_HOOK_HEAD = f"""#!/usr/bin/env bash
{_HOOK_MARK} (`scripts/check --install-hook`; skip once with --no-verify)
""" + r"""repo="$(git rev-parse --show-toplevel)" || exit 1
git_dir="$(git rev-parse --absolute-git-dir)" || exit 1
# The repo's virtualenv first (this worktree's, then the main checkout's): a bare python3 on
# PATH may predate the 3.11 that scripts/check needs.
common="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"
py=
for root in "$repo" "$common"; do
  for rel in .venv/bin/python venv/bin/python .venv/Scripts/python.exe venv/Scripts/python.exe; do
    if [ -z "$py" ] && [ -x "$root/$rel" ]; then py="$root/$rel"; fi
  done
done
# No virtualenv (the Macs' pm-managed installs have none): the interpreter the checkout's own
# launcher runs, else the first python on PATH new enough for scripts/check. A bare python3 is
# the last resort only, so macOS's /usr/bin/python3 (3.9) first on PATH is passed over.
ok311() { [ -n "$1" ] && "$1" -c 'import sys; sys.exit(sys.version_info < (3, 11))' </dev/null >/dev/null 2>&1; }
if [ -z "$py" ]; then
  for root in "$common" "${HERMES_HOME:-$HOME/.hermes}/hermes-agent"; do
    [ -x "$root/.hermes/bin/hermes" ] || continue
    argv="$("$root/.hermes/bin/hermes" --print-runtime-command </dev/null 2>/dev/null)" || continue
    # a JSON list (json.dumps: non-ASCII as \u escapes), which any python decodes; sed if none
    cand="$(printf '%s' "$argv" | python3 -c 'import json, sys; print(json.load(sys.stdin)[0])' \
      2>/dev/null)" || cand="$(printf '%s\n' "$argv" | sed -n 's/^\[ *"\([^"\\]*\)".*/\1/p')"
    if ok311 "$cand"; then py="$cand"; break; fi
  done
fi
if [ -z "$py" ]; then
  for name in python3.14 python3.13 python3.12 python3.11 python3 python; do
    while IFS= read -r cand; do
      if ok311 "$cand"; then py="$cand"; break 2; fi
    done < <(type -ap "$name")
  done
fi
[ -n "$py" ] || py="$(command -v python3 || command -v python)" || {
  echo "scripts/check hook: no python3 or python on PATH" >&2; exit 1; }
# A pm-managed install keeps the dependencies on its composed PYTHONPATH, not in a venv (the
# Macs' venv/ predates them, and prompt-surface imports them all): take PATH and PYTHONPATH from
# the composed environment (read-only, never syncs) of the main checkout, or, for a clone that
# is not an install (a mirror's worktree), of the installed Hermes checkout; minus that checkout
# itself, so the judged tree's own modules win.
for pm_root in "$common" "${HERMES_HOME:-$HOME/.hermes}/hermes-agent"; do
  [ -f "$pm_root/pm/environments.py" ] || continue
  pm_env="$(cd "$pm_root" && PYTHONHOME= PYTHONPATH="$pm_root" "$py" -m pm.environments --format json \
      2>/dev/null | "$py" -c '
import json, os, shlex, sys
# empty or non-object output = this python cannot compose the environment (e.g. a 3.9
# python3 in a checkout with no virtualenv): skip it quietly, a traceback reads as a failed push
try:
    env = json.load(sys.stdin)
except ValueError:
    sys.exit(1)
if not isinstance(env, dict):
    sys.exit(1)
root = os.path.realpath(sys.argv[1])
pp = [p for p in env.get("PYTHONPATH", "").split(os.pathsep) if p and os.path.realpath(p) != root]
if env.get("PATH") and pp:
    print("export PATH=" + shlex.quote(env["PATH"]))
    print("export PYTHONPATH=" + shlex.quote(os.pathsep.join(pp)))
' "$pm_root")" || continue
  [ -n "$pm_env" ] || continue
  eval "$pm_env"
  py="$(command -v python3 || command -v python || echo "$py")"
  break
done
candidate_admitted() {  # TREE-ISH HOST: classify committed bytes, never the checkout or ref name
  local tree=$1 host=$2 path entry missing="" why fix
  [ "$host" = Darwin ] || return 0
  # State shares these hooks with core. Require its existing layout, including
  # regular (not symlink) checker/guard files; ambiguous mixed/core trees refuse.
  # Every refusal names the candidate's shape and its remedy.
  for path in pyproject.toml run_agent.py hermes_cli agent; do
    if git cat-file -e "$tree:$path" 2>/dev/null; then
      echo "scripts/check: refused on this Mac: core candidate (has $path); portable core checks" \
        "belong on a pool worker: run hermes-core-wt test/ship there" >&2
      return 2
    fi
  done
  for path in scripts/check hermes-sync shared-config.json scripts/state-push-guard tests/state_guard_rules.py; do
    entry="$(git ls-tree "$tree" -- "$path")" || {
      echo "scripts/check: refused on this Mac: unreadable candidate $tree; push it from a pool worker" >&2
      return 2; }
    case "$entry" in
      "100644 blob "*|"100755 blob "*) ;;
      *) missing="${missing:+$missing }$path" ;;
    esac
  done
  [ -n "$missing" ] || return 0
  case " $missing " in
    *" scripts/check "*) why="no checker (missing or not a regular file: $missing)"
      fix="Macs admit only the current state layout through its own checker; push it from a pool worker" ;;
    *" hermes-sync "*|*" shared-config.json "*) why="unknown layout (missing or not a regular file: $missing)"
      fix="push it from a pool worker" ;;
    *) why="stale state layout (missing: $missing)"
      fix="rebase it onto current origin/state, or push it from a pool worker" ;;
  esac
  echo "scripts/check: refused on this Mac: $why; $fix" >&2
  return 2
}
judge() {  # judge TREE-ISH ARGS...: check out TREE-ISH alone and run its own scripts/check ARGS
  local tree=$1 tmp dir rc
  shift
  # Installed admission also protects historical core checkers. State still runs
  # its own real checker; recognizing it is not permission to skip any gate.
  candidate_admitted "$tree" "$(uname -s)" || return $?
  tmp="$(mktemp -d)" || return 1
  # Git for Windows: native git and python get this path verbatim when MSYS path conversion
  # is off (MSYS_NO_PATHCONV=1, as Hermes' terminal sets it), so hand them C:/... spelling.
  dir="$tmp"
  if command -v cygpath >/dev/null 2>&1; then dir="$(cygpath -m "$tmp")" || dir="$tmp"; fi
  GIT_INDEX_FILE="$dir/index" git read-tree "$tree" &&
    GIT_INDEX_FILE="$dir/index" git checkout-index -a -f --prefix="$dir/tree/" &&
    GIT_DIR="$git_dir" "$py" "$dir/tree/scripts/check" "$@" </dev/null
  rc=$?
  rm -rf "$tmp"
  return $rc
}
"""
_HOOKS = {
    # git may export a relative GIT_INDEX_FILE, and the checker runs from another directory.
    "pre-commit": _HOOK_HEAD + """\
index="$(git rev-parse --path-format=absolute --git-path index)" || exit 1
export GIT_INDEX_FILE="$index"
tree="$(git write-tree)" || exit 1
candidate_admitted "$tree" "$(uname -s)" || exit $?
git cat-file -e "$tree:scripts/check" 2>/dev/null || exit 0
judge "$tree" --staged
""",
    # stdin: "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref; an all-zero
    # local sha is a deletion. Each pushed branch tip is judged, as CI judges the PR as a whole;
    # intermediate commits are not judged one by one.
    "pre-push": _HOOK_HEAD + """status=0
while read -r _ local_sha _ _; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  candidate_admitted "$local_sha" "$(uname -s)" || { status=1; continue; }
  git cat-file -e "$local_sha:scripts/check" 2>/dev/null || continue
  judge "$local_sha" --commit "$local_sha" </dev/null || status=1
done
exit $status
""",
}

# name -> argv (relative to the repo root); mirrors the blocking steps in lint.yml, plus the
# unconditional guards CI runs as steps of repo-guards.yml (case collisions, lazy_deps imports,
# profile archives, blob size).
_GUARDS = {
    "footguns": ["scripts/check-windows-footguns.py", "--all"],
    "shebangs": ["scripts/check_bash_shebangs.py"],
    "no-tmp": ["scripts/check_no_tmp_literals.py"],
    "detached-spawns": ["scripts/check_detached_spawns.py"],
    "sqlite-sidecars": ["scripts/check_sqlite_sidecar_opens.py"],
    "install-root": ["scripts/install_root_lint.py"],
    "config-writers": ["scripts/check_config_yaml_writers.py"],
    "config-readers": ["scripts/check_config_yaml_readers.py"],
    "profile-create-entry": ["scripts/check_profile_create_entry.py"],
    "os-marker-fakes": ["scripts/ci/check_os_marker_fakes.py"],
    "agents-md": ["scripts/ci/check_agents_md_size.py"],
    "shims": ["scripts/move/generate_shims.py", "--check"],
    "case-collisions": ["scripts/check-case-collisions.py"],
    "line-endings": ["scripts/ci/check_line_endings.py"],
    "dockerfile-downloads": ["scripts/ci/check_dockerfile_downloads.py"],
    "lazy-deps": ["scripts/ci/check_lazy_deps_imports.py"],
    "profile-archives": ["scripts/ci/check_profile_archive_boundary.py"],

    # The committed system-prompt / tool-schema snapshot is what the code renders (the same
    # comparison tests/ci/test_prompt_surface.py makes, ~6s). Needs the repo's own dependencies,
    # which the hooks' python has; a push that edits a tool description without re-rendering stops here.
    "prompt-surface": ["scripts/ci/prompt_surface.py", "check"],
}
# Guards that judge a diff, not a tree: they get the same base/head as the ratchet
# (the blob-size step of repo-guards.yml).
_DIFF_GUARDS = {"blob-size": ["scripts/ci/check_blob_size.py"]}
_CHECKS = (*_GUARDS, *_DIFF_GUARDS, "ruff", "health")


@dataclass
class _Job:
    argv: list[str]
    cwd: Path = REPO
    env: dict[str, str] | None = None


def _run(job: _Job) -> tuple[int, str]:
    proc = subprocess.run(
        job.argv, cwd=job.cwd, env=job.env, capture_output=True, text=True, encoding="utf-8",
        errors="replace", stdin=subprocess.DEVNULL, timeout=900, check=False,
    )
    return proc.returncode, (proc.stdout + proc.stderr).strip()


def _git_in(env: dict[str, str], *args: str) -> None:
    proc = subprocess.run(["git", *args], cwd=REPO, env=env, capture_output=True, text=True,
                          stdin=subprocess.DEVNULL, timeout=300, check=False)
    if proc.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)} failed: {proc.stderr.strip()}")


@contextmanager
def _tree_snapshot(tree: str) -> Iterator[tuple[Path, dict[str, str]]]:
    """``tree`` checked out on its own, plus git env that sees exactly that tree.

    The user's worktree and index are never touched (no stash, no checkout): the tree is read
    into a private index and written to a temp dir. Always a snapshot, even when the worktree
    looks clean: ignored files (scratch, build output) are invisible to git status but not to
    the guards that walk the disk.
    """
    git_dir = gitio.git(REPO, "rev-parse", "--absolute-git-dir").strip()
    with tempfile.TemporaryDirectory(prefix="hermes-check-tree-") as tmp:
        root = Path(tmp) / "tree"
        root.mkdir()
        env = {**os.environ, "GIT_DIR": git_dir, "GIT_WORK_TREE": str(root),
               "GIT_INDEX_FILE": str(Path(tmp) / "index")}
        _git_in(env, "read-tree", tree)
        # -f: on a case-insensitive filesystem paths that differ only by case are one file, and
        # without it the second one aborts the snapshot before the case-collision guard runs
        # (the guards read the index, which keeps both).
        _git_in(env, "checkout-index", "-a", "-f")
        yield root, env


def _jobs(names: list[str], base: str | None, head: str | None,
          root: Path = REPO, env: dict[str, str] | None = None) -> dict[str, _Job]:
    jobs: dict[str, _Job] = {}
    for name in names:  # built only when selected: `--only shebangs` needs no ruff
        if name in _GUARDS:
            jobs[name] = _Job([sys.executable, *_GUARDS[name]], root, env)
        elif name in _DIFF_GUARDS:
            argv = [sys.executable, *_DIFF_GUARDS[name]]
            argv += ["--base", base] if base else []
            argv += ["--head", head] if head else []
            jobs[name] = _Job(argv, root, env)
        elif name == "ruff":
            jobs[name] = _Job([*resolve_ruff(root), "check", "."], root, env)
        else:
            # The ratchet reads both sides from git. It runs from `root` like every other job, so
            # in a snapshot its engine, rules and policy files (profile_scope_patterns.json, the
            # ruff pin) are the judged artifact's own, never unstaged working-tree bytes.
            health = [sys.executable, "-m", "scripts.code_health"]
            health += ["--base", base] if base else []
            health += ["--head", head] if head else []
            jobs[name] = _Job(health, root, env)
    # Required CI selects individual checks. Attach the stage guard to those
    # invocations too, judging the same materialized artifact as other guards.
    if (root / 'hermes_cli/kanban_source_pin_store.py').exists():
        jobs['source-custody-classes'] = _Job([sys.executable, 'scripts/check', '--custody-only'], root, env)
    return jobs


def _run_jobs(jobs: dict[str, _Job]) -> dict[str, tuple[int, str]]:
    with ThreadPoolExecutor(max_workers=len(jobs) or 1) as pool:
        return dict(zip(jobs, pool.map(_run, jobs.values()), strict=True))


def _run_all(args: argparse.Namespace) -> dict[str, tuple[int, str]]:
    if not (args.staged or args.commit):
        return _run_jobs(_jobs(args.only, args.base, None))
    # Hooks judge the bytes being committed or pushed, never the working tree. Without --base the
    # ratchet derives the base from the head (a commit's own merge-base) and the switch from main.
    if args.staged:
        tree = head = gitio.git(REPO, "write-tree").strip()
    else:
        head = gitio.resolve_rev(REPO, args.commit)
        tree = gitio.resolve_tree(REPO, head)
    with _tree_snapshot(tree) as (root, env):
        return _run_jobs(_jobs(args.only, args.base, head, root, env))


def _hooks_dir() -> Path:
    return Path(gitio.git(REPO, "rev-parse", "--path-format=absolute", "--git-path", "hooks").strip())


def _ours(target: Path) -> bool:
    return _HOOK_MARK in target.read_text(encoding="utf-8-sig", errors="replace")


def install_hook(kind: str) -> int:
    hooks = _hooks_dir()
    target = hooks / kind
    if target.exists() and not _ours(target):
        print(f"scripts/check: {target} exists and is not ours; add `python scripts/check` to it")
        return 1
    hooks.mkdir(parents=True, exist_ok=True)
    target.write_text(_HOOKS[kind], encoding="utf-8", newline="\n")
    os.chmod(target, 0o755)  # windows-footgun: ok — chmod +x is a no-op on Windows, harmless
    print(f"scripts/check: {kind} hook installed at {target} (every worktree of this clone)")
    return 0


def uninstall_hooks() -> int:
    removed = [t for t in (_hooks_dir() / k for k in _HOOKS) if t.exists() and _ours(t)]
    for target in removed:
        target.unlink()
        print(f"scripts/check: removed {target}")
    if not removed:
        print("scripts/check: no scripts/check hooks installed")
    return 0


def _selected(parser: argparse.ArgumentParser, only: str | None) -> list[str]:
    """Every check, or exactly the named ones. A typo must not turn into an empty green run."""
    if only is None:
        return list(_CHECKS)
    wanted = {name.strip() for name in only.split(",")} - {""}
    unknown = sorted(wanted - set(_CHECKS))
    if not wanted or unknown:
        parser.error(f"--only {only!r}: unknown or no check name ({', '.join(unknown) or 'empty'});"
                     f" valid: {', '.join(_CHECKS)}")
    return [name for name in _CHECKS if name in wanted]


def _upstream_sync_refused(rev: str) -> bool:
    """Pre-push (``--commit``): an untested upstream sync goes through scripts/ci/upstream_sync.py.

    The hook judges every pushed branch with that commit's own scripts/check, so this guard is live
    in every installed hook without reinstalling it.
    """
    from scripts.ci.upstream_sync import guard_push

    return guard_push(Path.cwd(), rev) != 0


_CUSTODY_STAGE_MODULES = (
    'hermes_cli/kanban_source_barrier.py', 'hermes_cli/kanban_source_pin_store.py',
    'hermes_cli/kanban_source_store_schema.py', 'hermes_cli/kanban_source_removal.py',
    'hermes_cli/kanban_source_publication.py', 'hermes_cli/kanban_source_refs.py',
    'scripts/ci/upstream_sync_push_argv.py',
)
# Stage A census: only the self-created authority store opens SQLite. Grow with
# later pieces; the full consumer manifest remains separate and is not weakened.
_CUSTODY_SQLITE = {('hermes_cli/kanban_source_pin_store.py', '_connect'): 'a'}


def _custody_flags(node, values):
    if isinstance(node, ast.Constant) and isinstance(node.value, int):
        return node.value
    if isinstance(node, ast.Name):
        return values.get(node.id)
    if isinstance(node, ast.Attribute) and isinstance(node.value, ast.Name) and node.value.id == 'os':
        return getattr(os, node.attr, None)
    if (isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id == 'getattr'
            and len(node.args) >= 2 and isinstance(node.args[0], ast.Name) and node.args[0].id == 'os'
            and isinstance(node.args[1], ast.Constant)):
        return getattr(os, node.args[1].value, 0)
    if isinstance(node, ast.BinOp) and isinstance(node.op, ast.BitOr):
        left, right = _custody_flags(node.left, values), _custody_flags(node.right, values)
        return None if left is None or right is None else left | right
    return None


def _custody_shape(node, source: str) -> bool:
    return ast.dump(node) == ast.dump(ast.parse(source, mode='eval').body)


def _custody_open_errors(call, scope, path, values) -> list[str]:
    flags = _custody_flags(call.args[1], values) if len(call.args) > 1 else None
    required = sum(getattr(os, name, 0) for name in
                   ('O_NONBLOCK', 'O_NOFOLLOW', 'O_CLOEXEC', 'O_NOCTTY'))
    if flags is None or flags & required != required:
        return ['K1 incomplete or unresolved open flags']
    if path != 'hermes_cli/kanban_source_barrier.py' or scope is None:
        return ['K1 raw open outside canonical helpers']
    if scope.name in {'open_directory', '_open_dir'} and flags & getattr(os, 'O_DIRECTORY', 0):
        return []
    if scope.name == 'open_regular':
        # The fd must be validated immediately, before use or return. Comments
        # are not exceptions; pin the actual regular-file rejection structure.
        nodes = sorted((n for n in ast.walk(scope) if isinstance(n, ast.If)
                        and n.lineno > call.lineno), key=lambda n: n.lineno)
        if (nodes and _custody_shape(nodes[0].test, 'not stat.S_ISREG(os.fstat(fd).st_mode)')
                and len(nodes[0].body) == 1 and isinstance(nodes[0].body[0], ast.Raise)):
            return []
    return ['K1 raw open lacks canonical directory/regular validation']


def _custody_ref_errors(call, scope, path, literals) -> list[str]:
    if not {'update-ref', 'fetch'} & set(literals):
        return []
    if (path == 'hermes_cli/kanban_source_publication.py' and scope is not None
            and scope.name == 'prove' and ast.unparse(call.func) == 'refs.run_git'
            and len(call.args) == 2 and _custody_shape(call.args[1],
                '["fetch", "--no-tags", "--no-write-fetch-head", "--refmap=", '
                '"--no-recurse-submodules", "--", name, tip]')):
        return []
    if (path != 'hermes_cli/kanban_source_refs.py' or scope is None
            or not isinstance(call.func, ast.Name) or call.func.id != 'run_git'
            or len(call.args) != 2 or not isinstance(call.args[1], ast.List)):
        return ['K2 mutation outside the checked argv seam']
    argv = call.args[1]
    if 'fetch' in literals:
        expected = ('["fetch", "--no-tags", "--no-write-fetch-head", "--refmap=", '
                    '"--no-recurse-submodules", "--", str(source), oid]')
        if scope.name == 'restore_ref' and _custody_shape(argv, expected):
            return []
        return ['K2 fetch may write destination refs or FETCH_HEAD']
    expected = {'create_ref': '["update-ref", "--no-deref", ref, oid, "0" * len(oid)]',
                'delete_exact': '["update-ref", "--no-deref", "-d", ref, oid]'}.get(scope.name)
    if expected is None or not _custody_shape(argv, expected):
        return ['K2 mutation lacks exact --no-deref/expected-OID argv']
    # Require the canonical symbolic-ref probe and an unconditional refusal on
    # every outcome other than rc=1. Pin both, rather than trusting a string.
    probes = [n for n in scope.body if isinstance(n, ast.Assign) and n.lineno < call.lineno
              and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name)
              and n.targets[0].id == 'symbol']
    refusals = [n for n in scope.body if isinstance(n, ast.If) and n.lineno < call.lineno
                and _custody_shape(n.test, 'symbol["status"] != "ok" or symbol["rc"] != 1')]
    probe = 'run_git(repo, ["symbolic-ref", "-q", ref], budget=budget)'
    if (len(probes) != 1 or not _custody_shape(probes[0].value, probe)
            or len(refusals) != 1 or not refusals[0].body
            or not isinstance(refusals[0].body[0], ast.Return)):
        return ['K2 mutation lacks symbolic-ref refusal']
    return []


def custody_class_errors(source: str, path: str) -> list[str]:
    """AST class guard over each landed module, with explicit SQLite census tags."""
    tree, lines = ast.parse(source), source.splitlines()
    parents = {child: parent for parent in ast.walk(tree) for child in ast.iter_child_nodes(parent)}
    aliases = {}
    constants = {}
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            aliases.update({a.asname or a.name: a.name for a in node.names})
        elif isinstance(node, ast.ImportFrom):
            aliases.update({a.asname or a.name: (node.module or '') + '.' + a.name for a in node.names})
        elif isinstance(node, ast.Assign) and parents.get(node) is tree:
            for target in node.targets:
                if isinstance(target, ast.Name):
                    constants[target.id] = _custody_flags(node.value, constants)
    errors = []
    for call in (n for n in ast.walk(tree) if isinstance(n, ast.Call)):
        scope = parents.get(call)
        while scope is not None and not isinstance(scope, (ast.FunctionDef, ast.AsyncFunctionDef)):
            scope = parents.get(scope)
        values = dict(constants)
        if scope is not None:
            for assign in sorted(ast.walk(scope), key=lambda n: getattr(n, 'lineno', 0)):
                if isinstance(assign, ast.Assign) and assign.lineno < call.lineno:
                    for target in assign.targets:
                        if isinstance(target, ast.Name):
                            values[target.id] = _custody_flags(assign.value, values)
                elif (isinstance(assign, ast.AugAssign) and assign.lineno < call.lineno
                      and isinstance(assign.target, ast.Name) and isinstance(assign.op, ast.BitOr)):
                    extra = _custody_flags(assign.value, values)
                    values[assign.target.id] = (None if extra is None else
                                               (values.get(assign.target.id) or 0) | extra)
        spelling = ast.unparse(call.func)
        first, dot, rest = spelling.partition('.')
        resolved = aliases.get(first, first) + (dot + rest if dot else '')
        line = lines[call.lineno - 1]
        prefix = f'{path}:{call.lineno}'
        if resolved == 'os.open':
            errors.extend(prefix + ' ' + error for error in _custody_open_errors(call, scope, path, values))
        if (spelling == 'open' or isinstance(call.func, ast.Attribute)
                and call.func.attr in {'open', 'read_text', 'read_bytes'}):
            if resolved != 'os.open':
                errors.append(prefix + ' K1 high-level read outside canonical helper')
        literals = [n.value for n in ast.walk(call) if isinstance(n, ast.Constant) and isinstance(n.value, str)]
        errors.extend(prefix + ' ' + error for error in _custody_ref_errors(call, scope, path, literals))
        sqlite_call = (resolved in {'sqlite3.connect', 'lockguard.connect', 'db.connect'}
                       or resolved.endswith(('.lockguard.connect', '.db.connect', '.kanban_db.connect'))
                       or resolved.endswith(('.connect_tracked', '.connect_with_identity'))
                       or resolved in {'connect_tracked', 'connect_with_identity'})
        if sqlite_call and ':memory:' not in literals:
            expected = _CUSTODY_SQLITE.get((path, scope.name if scope is not None else ''))
            if expected is None or '# custody-sqlite: ' + expected not in line:
                errors.append(prefix + ' K1-L SQLite tag missing or differs from census')
    return errors


def custody_classes(root: Path) -> int:
    errors = []
    for path in _CUSTODY_STAGE_MODULES:
        try:
            source = (root / path).read_text(encoding='utf-8')
            errors.extend(custody_class_errors(source, path))
        except (OSError, SyntaxError) as exc:
            errors.append(f'{path}: cannot check: {exc}')
    for error in errors:
        print(error)
    return int(bool(errors))


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="scripts/check", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--only", help=f"comma list of: {', '.join(_CHECKS)}")
    parser.add_argument("--base", help="base revision for the code-health ratchet and blob-size")
    parser.add_argument('--custody-only', action='store_true', help='check landed custody class census')
    target = parser.add_mutually_exclusive_group()
    target.add_argument("--staged", action="store_true",
                        help="check the index (what `git commit` records), not the working tree")
    target.add_argument("--commit", metavar="REV", help="check one commit's tree (pre-push)")
    parser.add_argument("--install-hook", nargs="?", const="pre-commit", choices=sorted(_HOOKS),
                        help="run on every commit (default) or every push")
    parser.add_argument("--uninstall-hook", action="store_true", help="remove our git hooks")
    args = parser.parse_args(argv)
    if args.custody_only:
        return custody_classes(REPO)
    args.only = _selected(parser, args.only)
    if args.install_hook:
        return install_hook(args.install_hook)
    if args.uninstall_hook:
        return uninstall_hooks()
    if sys.platform == "darwin":
        print("scripts/check: portable core checks belong on a pool worker, not this Mac; "
              "run the unchanged required gates there", file=sys.stderr)
        return 2
    if args.commit and _upstream_sync_refused(args.commit):
        return 1
    try:
        results = _run_all(args)
    except RuntimeError as exc:
        print(f"scripts/check: {exc}", file=sys.stderr)
        return 2
    failed = [name for name, (code, _) in results.items() if code != 0]
    # A passing health run still carries advisories and comment-allowed findings that the
    # reviewer must see, so its report is always shown.
    for name, (code, output) in results.items():
        if code != 0 or name == "health":
            label = "failed" if code != 0 else "ok"
            print(f"\n=== {name} ({label}) ===\n{output.rstrip()}")
    status = "FAILED: " + ", ".join(failed) if failed else "ok"
    print(f"\nscripts/check: {len(results)} checks, {status}")
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
