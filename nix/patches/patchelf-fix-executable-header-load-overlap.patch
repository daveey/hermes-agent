+template<ElfFileParams>
+Elf_Phdr * ElfFile<ElfFileParamNames>::findLoadSegmentByOffset(Elf_Off offset)
+{
+    for (auto & phdr : phdrs)
+        if (rdi(phdr.p_type) == PT_LOAD && rdi(phdr.p_offset) <= offset &&
+            rdi(phdr.p_offset) + rdi(phdr.p_filesz) > offset)
+            return &phdr;
+    return nullptr;
+}
